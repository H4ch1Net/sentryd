# Copy to .env — sentryd loads it automatically. Never commit the real .env.

# OpenRouter API key for AI alert triage (https://openrouter.ai/keys).
# Leave unset to run without AI: detection works fully without it.
OPENROUTER_API_KEY=

# Model used for triage writeups (any OpenRouter chat model id).
SENTRYD_TRIAGE_MODEL=openai/gpt-4o-mini
